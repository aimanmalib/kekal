{
  "_doc": "Runtime values read by the SDK scripts, web app and keeper. programId null = the address in the SDK IDL. Mint null = created on demand (localnet) or set after the devnet deploy.",
  "defaultCluster": "devnet",
  "clusters": {
    "localnet": {
      "rpcUrls": ["http://127.0.0.1:18899"],
      "validator": { "rpcPort": 18899, "faucetPort": 19900, "gossipPort": 18000, "dynamicPortRange": "18001-18040" },
      "explorerTx": "https://explorer.solana.com/tx/{sig}?cluster=custom&customUrl=http%3A%2F%2F127.0.0.1%3A18899",
      "programId": null,
      "keysDir": null,
      "mints": { "kusd": null, "usdc": null },
      "tokenDecimals": 6,
      "limits": {
        "minResponseSecs": 5,
        "maxResponseSecs": 7776000,
        "minRepairSecs": 5,
        "maxRepairSecs": 7776000,
        "minDisputeSecs": 5,
        "maxDisputeSecs": 7776000,
        "minHeartbeatSecs": 5,
        "maxHeartbeatSecs": 15552000,
        "maxGraceSecs": 2592000,
        "minTermSecs": 5,
        "maxTermSecs": 473040000,
        "disputeTimeoutSecs": 5,
        "claimCooldownSecs": 1,
        "maxClaimsPerWarranty": 8
      },
      "lifecycle": {
        "airdropSol": 10,
        "mintAmount": "1000000000",
        "depositAmount": "500000000",
        "reserve": "25000000",
        "termSecs": 86400,
        "shortTermSecs": 8,
        "shopWindows": { "responseSecs": 5, "repairSecs": 5, "disputeSecs": 5, "heartbeatSecs": 3600, "graceSecs": 0 },
        "dyingShopWindows": { "responseSecs": 5, "repairSecs": 5, "disputeSecs": 5, "heartbeatSecs": 5, "graceSecs": 0 },
        "dyingShopSol": 0.05,
        "timeoutSecs": 180
      }
    },
    "devnet": {
      "rpcUrls": ["https://api.devnet.solana.com"],
      "explorerTx": "https://explorer.solana.com/tx/{sig}?cluster=devnet",
      "programId": null,
      "keysDir": "~/.config/kekal/keys",
      "mints": { "kusd": null, "usdc": null },
      "tokenDecimals": 6,
      "limits": {
        "minResponseSecs": 60,
        "maxResponseSecs": 7776000,
        "minRepairSecs": 60,
        "maxRepairSecs": 7776000,
        "minDisputeSecs": 60,
        "maxDisputeSecs": 7776000,
        "minHeartbeatSecs": 60,
        "maxHeartbeatSecs": 15552000,
        "maxGraceSecs": 2592000,
        "minTermSecs": 300,
        "maxTermSecs": 473040000,
        "disputeTimeoutSecs": 300,
        "claimCooldownSecs": 30,
        "maxClaimsPerWarranty": 8
      },
      "lifecycle": {
        "airdropSol": 0,
        "mintAmount": "1000000000",
        "depositAmount": "200000000",
        "reserve": "25000000",
        "termSecs": 31536000,
        "shortTermSecs": 300,
        "shopWindows": { "responseSecs": 60, "repairSecs": 120, "disputeSecs": 60, "heartbeatSecs": 86400, "graceSecs": 3600 },
        "dyingShopWindows": { "responseSecs": 60, "repairSecs": 60, "disputeSecs": 60, "heartbeatSecs": 60, "graceSecs": 0 },
        "dyingShopSol": 0.03,
        "timeoutSecs": 900
      }
    }
  },
  "web": {
    "_doc": "Web app values. /api/rpc forwards only allowedMethods (never sendTransaction: signed transactions go through the relayer); programScopedMethods must name the Kekal program. DATA_BACKEND picks the store; KEKAL_SQLITE_PATH and KEKAL_MIGRATIONS_DIR override the paths below.",
    "locales": { "supported": ["en", "ms"], "fallback": "en", "cookie": "kekal_lang", "cookieMaxAgeDays": 365 },
    "rpc": {
      "allowedMethods": [
        "getAccountInfo", "getMultipleAccounts", "getProgramAccounts", "getLatestBlockhash", "getSignatureStatuses",
        "getSignaturesForAddress", "getTransaction", "getBalance", "getTokenAccountBalance",
        "getMinimumBalanceForRentExemption", "getSlot"
      ],
      "programScopedMethods": ["getProgramAccounts"],
      "timeoutMs": 8000,
      "maxBodyBytes": 16384,
      "maxBatch": 10,
      "retryStatuses": [429, 500, 502, 503, 504]
    },
    "relay": {
      "_doc": "POST /api/relay pays the fee for a transaction the holder already signed. At least one key other than the relayer must sign. Only these Kekal instructions, TransferChecked of a non-zero amount of an allowed mint out of the signer's own associated account, and creation of the associated account that transfer pays into (at most maxAccountCreates per transaction, accountCreatesPerDay overall) pass. The relayer key may appear only as fee payer and in the account slots named in payerAccounts. Limits are fixed windows.",
      "keyRole": "relayer",
      "allowedInstructions": [
        "transfer_holder", "file_claim", "confirm_resolved", "escalate",
        "settle_unanswered", "close_stale", "settle_stale_dispute", "declare_dormant", "claim_orphan", "release_expired"
      ],
      "payerAccounts": ["payer", "payout.payer"],
      "maxInstructions": 4,
      "maxAccountCreates": 1,
      "maxTxBytes": 1232,
      "perHolderPerHour": 10,
      "perIpPerHour": 30,
      "globalPerDay": 2000,
      "accountCreatesPerDay": 100,
      "preflightCommitment": "confirmed"
    },
    "session": {
      "_doc": "Seller and arbiter sign-in: nonce, signed message, httpOnly cookie. KEKAL_SESSION_SECRET (32+ chars) signs the cookie; without it the session endpoints answer 503.",
      "cookie": "kekal_session",
      "ttlSecs": 43200,
      "nonceTtlSecs": 300,
      "noncePerIpPerHour": 30,
      "minSecretLength": 32
    },
    "clientIp": {
      "_doc": "The peer is X-Real-IP (set by the reverse proxy), else the last X-Forwarded-For entry. The CDN header is trusted only when that peer is inside cdnRanges (Cloudflare published ranges).",
      "cdnHeader": "cf-connecting-ip",
      "cdnRanges": [
        "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22", "141.101.64.0/18", "108.162.192.0/18",
        "190.93.240.0/20", "188.114.96.0/20", "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
        "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22",
        "2400:cb00::/32", "2606:4700::/32", "2803:f800::/32", "2405:b500::/32", "2405:8100::/32", "2a06:98c0::/29", "2c0f:f248::/32"
      ]
    },
    "site": {
      "_doc": "Public address and link previews. KEKAL_SITE_URL overrides url. robots.txt lets every crawler read pages but not /api/; previewBots get their own group so chat and social link previews keep working if the default group is ever narrowed. The OG card is apps/web/src/app/opengraph-image.png, drawn by brand/render-og.mjs; its alt text is meta.ogAlt in the locale files.",
      "url": "https://kekal.sasateguh.com",
      "disallow": ["/api/"],
      "previewBots": [
        "Twitterbot", "facebookexternalhit", "Facebot", "LinkedInBot", "Slackbot-LinkExpanding", "Discordbot",
        "TelegramBot", "WhatsApp", "Applebot"
      ],
      "ogImage": { "width": 1200, "height": 630, "maxBytes": 307200, "altMaxChars": 300 }
    },
    "currency": "kUSD",
    "data": { "backend": "sqlite", "sqlitePath": "data/kekal.db", "migrationsDir": "supabase/migrations" }
  }
}
