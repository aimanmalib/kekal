# Host values for deploy/deploy.sh and deploy/uptime.sh. Copy to deploy/hos.env (not tracked) and fill in.
KEKAL_DOMAIN=kekal.example.com
# Docker network the reverse proxy shares with the app container.
KEKAL_NETWORK=proxy
# Reverse proxy container and its dynamic configuration folder (Traefik file provider).
PROXY_CONTAINER=proxy
PROXY_DYNAMIC_DIR=/traefik/dynamic
CERT_RESOLVER=letsencrypt
# Folder with the server role keys (solana-keygen files), mounted read-only. It must exist; an empty folder is fine
# while the program is not deployed (the relayer and demo then report themselves unavailable).
KEKAL_KEYS_HOST=/srv/kekal/keys
# Optional env file for the containers (e.g. RPC_URLS). Never committed.
KEKAL_ENV_FILE=
# Extra connect-src origins for the CSP (space separated); empty = 'self' only.
CONNECT_SRC=
# 1 = also run the keeper (only once the program is on the cluster).
KEKAL_KEEPER=0
# Image builder that accepts `docker build` arguments; defaults to docker build.
BUILD_CMD=
# Notifier for deploy/uptime.sh: called as "$NOTIFY_CMD" "<text>" <info|warn>.
NOTIFY_CMD=
